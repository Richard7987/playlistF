---
import '../styles/global.css';
import playlistData from '../data/playlist.json';
import dedicationsRaw from '../data/dedications.json';
import { markedIndices, shiftLines, type Dedication, type Line } from '../lib/time';

interface Track {
  slug: string;
  title: string;
  artist: string;
  album: string;
  duration: number;
  cover: string | null;
  streamUrl: string;
  colors: { bg: string; bgAlt: string; accent: string; text: string; muted: string };
  lyrics: { synced: boolean; lines: Line[] };
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${base}/${p.replace(/^\//, '')}`;
const dedications = dedicationsRaw as Record<string, Dedication>;
const raw = playlistData.tracks as Track[];

const tracks = raw.map((t) => {
  const d = dedications[t.slug] ?? {};
  const lines = shiftLines(t.lyrics.lines, Number(d.lyricsOffset) || 0);
  return {
    slug: t.slug,
    title: t.title,
    artist: t.artist,
    album: t.album,
    duration: t.duration,
    streamUrl: t.streamUrl,
    colors: t.colors,
    synced: t.lyrics.synced,
    coverUrl: t.cover ? withBase(t.cover) : null,
    lines,
    marked: markedIndices(d, lines),
    dedication: d.dedication?.trim() || null,
    fragmentNote: d.fragmentNote?.trim() || null,
  };
});

const hasData = tracks.length > 0;
const shareLink = playlistData.shareUrl || playlistData.navidromeUrl || '#';
const first = tracks[0];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fa</title>
    <meta name="description" content="Una playlist, hecha web." />
    <meta name="theme-color" content="#08070b" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23100e15'/%3E%3Ccircle cx='16' cy='16' r='7' fill='%23f4a24c'/%3E%3Ccircle cx='16' cy='16' r='2' fill='%23100e15'/%3E%3C/svg%3E"
    />
    <link rel="preconnect" href={playlistData.navidromeUrl} />
  </head>
  <body>
    <canvas id="gl" aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>

    {
      !hasData ? (
        <div class="wrap">
          <main style="text-align:center;display:flex;flex-direction:column;gap:.8rem;margin:auto">
            <p class="label">playlist</p>
            <h1 class="title" style="font-size:clamp(3rem,14vw,7rem)">Fa</h1>
            <p class="lyrics-empty">
              Aún no hay snapshot. Corre <code>npm run pull</code> y commitea.
            </p>
            <p class="sign">hecho con cariño y mucho tiempo libre</p>
          </main>
        </div>
      ) : (
        <div class:list={['wrap', { 'no-lyrics': first.lines.length === 0, 'no-dedication': !first.dedication }]}>
          <div class="frame">
            <div class="stage">
              <div class="left">
                <div class="art-wrap">
                  <img
                    class="cover"
                    id="cover-a"
                    alt=""
                    src={first.coverUrl ?? undefined}
                    style={first.coverUrl ? undefined : 'background:linear-gradient(160deg,var(--bg-alt),var(--bg))'}
                    width="640"
                    height="640"
                  />
                  <img class="cover" id="cover-b" alt="" aria-hidden="true" width="640" height="640" />
                </div>
                <button class="queue-btn" id="queue-toggle" aria-expanded="false" aria-controls="queue">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 7h11M4 12h11M4 17h7" /><circle cx="19" cy="16" r="2.4" /><path d="M21.4 16V8l-2.4.8" />
                  </svg>
                  <span><span id="queue-count">{tracks.length}</span> canciones</span>
                </button>
                <div class="meta">
                  <div class="title" id="title">{first.title}</div>
                  <div class="artist" id="artist">{first.album ? `${first.artist} — ${first.album}` : first.artist}</div>
                </div>
                <div class="transport">
                  <button class="tnav" id="prev" aria-label="Canción anterior">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 6v12h2V6zm3 6l9 6V6z" /></svg>
                  </button>
                  <button class="play" id="play" aria-label="Reproducir">
                    <svg id="play-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                  </button>
                  <button class="tnav" id="next" aria-label="Canción siguiente">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15 6v12h2V6zm-1 6L5 6v12z" /></svg>
                  </button>
                  <div class="scrub-area">
                    <div class="scrub" id="scrub">
                      <div class="scrub-fill" id="scrub-fill" />
                      <div class="scrub-knob" id="scrub-knob" />
                    </div>
                    <div class="times"><span id="t-cur">0:00</span><span id="t-dur">0:00</span></div>
                  </div>
                </div>
                <p class="load-error" id="load-error" role="alert" hidden>No se pudo cargar el audio de esta canción.</p>
              </div>

              <div class="right">
                <div class="label">letra</div>
                <div class="lyrics" id="lyrics"><div class="lyrics-inner" id="lyrics-inner" /></div>
                <div class="frag-note" id="frag-note" hidden />
              </div>
            </div>
          </div>

          <div class="dedication" id="dedication" hidden={!first.dedication}>
            <div class="ded-card">
              <div class="label">dedicatoria</div>
              <p class="ded-text" id="ded-text">{first.dedication}</p>
            </div>
          </div>

          <div class="footer">
            <a class="nav-link" href={shareLink} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" />
              </svg>
              Abrir la playlist en Navidrome
            </a>
            <div class="sign">hecho con cariño y mucho tiempo libre</div>
          </div>

          <div class="queue" id="queue" hidden>
            <div class="queue-backdrop" id="queue-backdrop" />
            <div class="queue-panel" role="dialog" aria-modal="true" aria-label="Playlist Fa">
              <div class="queue-head">
                <span class="label">la playlist</span>
                <button class="queue-close" id="queue-close" aria-label="Cerrar">&#10005;</button>
              </div>
              <ol class="queue-list" id="queue-list">
                {tracks.map((t, i) => (
                  <li>
                    <button class="queue-item" data-i={i} aria-current={i === 0 ? 'true' : undefined}>
                      <span class="queue-num">{String(i + 1).padStart(2, '0')}</span>
                      <span class="queue-cover" style={t.coverUrl ? `background-image:url(${t.coverUrl})` : undefined} />
                      <span class="queue-text">
                        <span class="queue-title">{t.title}</span>
                        <span class="queue-artist">{t.artist}</span>
                      </span>
                    </button>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </div>

        <script is:inline type="application/json" id="tracks" set:html={JSON.stringify(tracks).replace(/</g, '\\u003c')} />
      )
    }

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
