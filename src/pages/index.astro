---
import '../styles/global.css';
import playlistData from '../data/playlist.json';
import dedicationsRaw from '../data/dedications.json';
import { markedIndices, type Dedication, type Line } from '../lib/time';

interface Track {
  slug: string;
  title: string;
  artist: string;
  album: string;
  duration: number;
  cover: string | null;
  streamUrl: string;
  colors: { bg: string; bgAlt: string; accent: string; text: string; muted: string };
  lyrics: { synced: boolean; lines: Line[] };
}

const base = import.meta.env.BASE_URL;
const dedications = dedicationsRaw as Record<string, Dedication>;
const raw = playlistData.tracks as Track[];

const tracks = raw.map((t) => {
  const d = dedications[t.slug] ?? {};
  return {
    slug: t.slug,
    title: t.title,
    artist: t.artist,
    album: t.album,
    duration: t.duration,
    streamUrl: t.streamUrl,
    colors: t.colors,
    synced: t.lyrics.synced,
    coverUrl: t.cover ? base + t.cover : null,
    lines: t.lyrics.lines,
    marked: markedIndices(d, t.lyrics.lines),
    dedication: d.dedication?.trim() || null,
    fragmentNote: d.fragmentNote?.trim() || null,
  };
});

const hasData = tracks.length > 0;
const shareLink = playlistData.shareUrl || playlistData.navidromeUrl || '#';
const first = tracks[0];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fa</title>
    <meta name="description" content="Una playlist, hecha web." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href={playlistData.navidromeUrl} />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,400;1,9..144,500&family=Hanken+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <canvas id="gl" aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>

    {
      !hasData ? (
        <div class="wrap">
          <main style="text-align:center;display:flex;flex-direction:column;gap:.8rem;margin:auto">
            <p class="label">playlist</p>
            <h1 class="title" style="font-size:clamp(3rem,14vw,7rem)">Fa</h1>
            <p class="lyrics-empty">
              Aún no hay snapshot. Corre <code>npm run pull</code> y commitea.
            </p>
            <p class="sign">hecho con cariño y mucho tiempo libre</p>
          </main>
        </div>
      ) : (
        <div class="wrap">
          <div class="frame">
            <div class="stage">
              <div class="left">
                <div class="counter"><b id="c-cur">01</b> / <span>{String(tracks.length).padStart(2, '0')}</span></div>
                <div class="art-wrap">
                  <button class="nav-btn prev" id="prev" aria-label="Canción anterior">&#8249;</button>
                  <img class="cover" id="cover" alt="" src={first.coverUrl ?? ''} width="640" height="640" />
                  <button class="nav-btn next" id="next" aria-label="Canción siguiente">&#8250;</button>
                </div>
                <div class="dots" id="dots" role="tablist" aria-label="Canciones">
                  {tracks.map((_, i) => (
                    <button role="tab" aria-label={`Canción ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} data-i={i} />
                  ))}
                </div>
                <div class="meta">
                  <div class="title" id="title">{first.title}</div>
                  <div class="artist" id="artist">{first.album ? `${first.artist} — ${first.album}` : first.artist}</div>
                </div>
                <div class="transport">
                  <button class="play" id="play" aria-label="Reproducir">
                    <svg id="play-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                  </button>
                  <div class="scrub-area">
                    <div class="scrub" id="scrub">
                      <div class="scrub-fill" id="scrub-fill" />
                      <div class="scrub-knob" id="scrub-knob" />
                    </div>
                    <div class="times"><span id="t-cur">0:00</span><span id="t-dur">0:00</span></div>
                  </div>
                </div>
              </div>

              <div class="right">
                <div class="label">letra</div>
                <div class="lyrics" id="lyrics"><div class="lyrics-inner" id="lyrics-inner" /></div>
                <div class="frag-note" id="frag-note" hidden />
              </div>
            </div>
          </div>

          <div class="dedication">
            <div class="ded-card" id="ded-card" hidden>
              <div class="label">dedicatoria</div>
              <p class="ded-text" id="ded-text" />
            </div>
          </div>

          <div class="footer">
            <a class="nav-link" href={shareLink} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" />
              </svg>
              Abrir la playlist en Navidrome
            </a>
            <div class="sign">hecho con cariño y mucho tiempo libre</div>
          </div>
        </div>

        <script type="application/json" id="tracks" set:html={JSON.stringify(tracks)} />
      )
    }

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
