# Navidrome — SOLO para el snapshot local (npm run pull). Este archivo se commitea; .env NO.
NAVIDROME_URL=https://mu.richard69.lat
NAVIDROME_USER=usuario_admin
NAVIDROME_PASS=password

# Playlist a publicar
PLAYLIST_NAME=Fa

# El share transcodifica al crearlo (más ligero que FLAC crudo, mejor en móvil / iOS).
# format: mp3 (más compatible) | opus | aac | raw (raw = sin transcodificar)
NAVIDROME_SHARE_FORMAT=mp3
NAVIDROME_SHARE_BITRATE=128
